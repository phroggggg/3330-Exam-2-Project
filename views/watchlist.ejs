<%- include('partials/header', { title }) %>

<div class="page-head">
  <p class="eyebrow">Your list</p>
  <h1>My watchlist</h1>
  <p>Track what you plan to watch, what you're watching now, and what you've finished.</p>
</div>

<nav class="chips" aria-label="Filter by status">
  <a class="chip <%= activeStatus === '' ? 'active' : '' %>" href="/watchlist">All (<%= counts.All %>)</a>
  <% statuses.forEach(function (s) { %>
    <a class="chip <%= activeStatus === s ? 'active' : '' %>" href="/watchlist?status=<%= encodeURIComponent(s) %>"><%= s %> (<%= counts[s] %>)</a>
  <% }) %>
</nav>

<% if (entries.length) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Title</th><th>Status</th><th>Progress</th><th>Update</th><th></th></tr>
      </thead>
      <tbody>
        <% entries.forEach(function (e) { %>
          <tr data-entry-id="<%= e.id %>">
            <td>
              <a href="/catalog?anime=<%= e.anime.id %>"><strong><%= e.anime.title %></strong></a><br>
              <span class="muted small"><%= e.anime.genre %></span>
            </td>
            <td><span class="badge js-status <%= e.status === 'Completed' ? 'badge-ok' : '' %>"><%= e.status %></span></td>
            <td class="progress-cell">
              <progress class="js-progress" value="<%= e.episodesWatched %>" max="<%= e.anime.totalEpisodes %>"></progress>
              <span class="muted small"><span class="js-episodes"><%= e.episodesWatched %></span> / <%= e.anime.totalEpisodes %> eps</span>
            </td>
            <td>
              <form class="row-actions" method="POST" action="/watchlist/<%= e.id %>/update">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select id="status-<%= e.id %>" name="status" aria-label="Status for <%= e.anime.title %>">
                  <% statuses.forEach(function (s) { %><option value="<%= s %>" <%= e.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
                </select>
                <input type="number" name="episodesWatched" min="0" max="<%= e.anime.totalEpisodes %>" value="<%= e.episodesWatched %>" aria-label="Episodes watched for <%= e.anime.title %>">
                <button class="btn btn-ghost btn-sm" type="submit">Save</button>
              </form>
            </td>
            <td>
              <div class="row-actions">
                <% if (e.episodesWatched < e.anime.totalEpisodes) { %>
                  <form method="POST" action="/watchlist/<%= e.id %>/update" class="inline-form js-increment">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="episodesWatched" value="<%= e.episodesWatched + 1 %>">
                    <button class="btn btn-primary btn-sm" type="submit" title="Mark next episode watched">+1 ep</button>
                  </form>
                <% } %>
                <form method="POST" action="/watchlist/<%= e.id %>/delete" class="inline-form" data-confirm="Remove <%= e.anime.title %> from your watchlist?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <p class="empty">
    <%= activeStatus ? 'Nothing with that status yet.' : 'Your watchlist is empty.' %>
    <a href="/catalog">Browse the catalog</a> or add a title below.
  </p>
<% } %>

<section class="form-card section-gap">
  <h2>Add a title</h2>
  <% if (addable.length) { %>
    <form method="POST" action="/watchlist" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="animeId">Anime</label>
        <select id="animeId" name="animeId" required>
          <option value="">Choose a title…</option>
          <% addable.forEach(function (a) { %><option value="<%= a.id %>"><%= a.title %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="newStatus">Status</label>
        <select id="newStatus" name="status">
          <% statuses.forEach(function (s) { %><option value="<%= s %>"><%= s %></option><% }) %>
        </select>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Add to watchlist</button></div>
    </form>
  <% } else { %>
    <p class="muted">You've added every title in the catalog. Impressive!</p>
  <% } %>
</section>

<%- include('partials/footer') %>
